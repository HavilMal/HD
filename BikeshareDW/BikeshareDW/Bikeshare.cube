  <MdxScripts>
    <MdxScript dwd:design-time-name="16da6c6b-8590-4ef5-b826-3b6cef3d6e6a">
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>0001-01-01T00:00:00Z</CreatedTimestamp>
      <LastSchemaUpdate>0001-01-01T00:00:00Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>/*
The CALCULATE command controls the aggregation of leaf cells in the cube.
If the CALCULATE command is deleted or modified, the data within the cube is affected.
You should edit this command only if you manually specify how the cube is aggregated.
*/
CALCULATE;


CREATE MEMBER CURRENTCUBE.[Measures].[Avg Duration] AS
  IIF(
      [Measures].[Fact Rental Count] = 0, 
      NULL, 
      [Measures].[Duration] / [Measures].[Fact Rental Count]
  ),
  FORMAT_STRING = "#,##0.00",
  VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[Avg Distance] AS
  IIF(
      [Measures].[Fact Rental Count] = 0, 
      NULL, 
      [Measures].[Distance] / [Measures].[Fact Rental Count]
  ),
  FORMAT_STRING = "#,##0.00",
  VISIBLE = 1;


CREATE MEMBER CURRENTCUBE.[Measures].[Start Latitude]
AS [Start Location].[Latitude].CurrentMember.Value,
VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[Start Longitude]
AS [Start Location].[Longitude].CurrentMember.Value,
VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[End Latitude]
AS [End Location].[Latitude].CurrentMember.Value,
VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[End Longitude]
AS [End Location].[Longitude].CurrentMember.Value,
VISIBLE = 1;


CREATE MEMBER CURRENTCUBE.[Measures].[Avg Daily Rental Count] AS
    AVG(
        NONEMPTY(
            [Start Date].[Full Date].[Full Date].MEMBERS,
            [Measures].[Fact Rental Count]
        ),
        [Measures].[Fact Rental Count]
    ),
    FORMAT_STRING = "#,##0.00",
    VISIBLE = 1;
</Text>
        </Command>
      </Commands>
    </MdxScript>
  </MdxScripts>
</Cube>