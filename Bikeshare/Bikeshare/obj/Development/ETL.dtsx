            <component
              refId="Package\Czyszczenie Stacji\Najnowsza Nazwa Stacji"
              componentClassID="Microsoft.Lookup"
              contactInfo="Lookup;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;6"
              description="Joins additional columns to the data flow by looking up values in a table. For example, join to the 'employee id' column the employees table to get 'hire date' and 'employee name'. We recommend this transformation when the lookup table can fit into memory."
              name="Najnowsza Nazwa Stacji"
              usesDispositions="true"
              version="6">
              <properties>
                <property
                  dataType="System.String"
                  description="Specifies the SQL statement that generates the lookup table."
                  expressionType="Notify"
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">WITH all_station_names AS (
    SELECT 
        start_station_id AS station_id, 
        start_station_name AS station_name, 
        started_at AS timestamp
    FROM [dbo].[Wypożyczenia Poczekalnia]
    WHERE start_station_id IS NOT NULL
    
    UNION ALL
    
    SELECT 
        end_station_id AS station_id, 
        end_station_name AS station_name, 
        ended_at AS timestamp
    FROM [dbo].[Wypożyczenia Poczekalnia]
    WHERE end_station_id IS NOT NULL
),
ranked_names AS (
    SELECT 
        station_id, 
        station_name,
        ROW_NUMBER() OVER(PARTITION BY station_id ORDER BY timestamp ASC) AS rn
    FROM all_station_names
)
SELECT 
    station_id, 
    station_name
FROM ranked_names
WHERE rn = 1;</property>
                <property
                  dataType="System.String"
                  description="Specifies a SQL statement that uses parameters to generate the lookup table."
                  expressionType="Notify"
                  name="SqlCommandParam"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">select * from (WITH all_station_names AS (
    SELECT 
        start_station_id AS station_id, 
        start_station_name AS station_name, 
        started_at AS timestamp
    FROM [dbo].[Wypożyczenia Poczekalnia]
    WHERE start_station_id IS NOT NULL
    
    UNION ALL
    
    SELECT 
        end_station_id AS station_id, 
        end_station_name AS station_name, 
        ended_at AS timestamp
    FROM [dbo].[Wypożyczenia Poczekalnia]
    WHERE end_station_id IS NOT NULL
),
ranked_names AS (
    SELECT 
        station_id, 
        station_name,
        ROW_NUMBER() OVER(PARTITION BY station_id ORDER BY timestamp ASC) AS rn
    FROM all_station_names
)
SELECT 
    station_id, 
    station_name
FROM ranked_names
WHERE rn = 1;) [refTable]
where [refTable].[station_id] = ?</property>
                <property
