    <DTS:Executable
      DTS:refId="Package\Generowanie Dat"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:Disabled="True"
      DTS:DTSID="{17CD2273-87E7-4DA7-8757-BB01FFC3D96E}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Generowanie Dat"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{F48D2EBA-6758-4205-960F-CBA21ACDD8C4}"
          SQLTask:SqlStatementSource="SET DATEFIRST 1;&#xA;&#xA;DECLARE @StartDate DATE = '2020-05-01';&#xA;DECLARE @EndDate DATE = '2024-08-31';&#xA;&#xA;WITH DateCTE AS (&#xA;    SELECT @StartDate AS DateValue&#xA;    UNION ALL&#xA;    SELECT DATEADD(day, 1, DateValue)&#xA;    FROM DateCTE&#xA;    WHERE DateValue &lt; @EndDate&#xA;)&#xA;INSERT INTO Dim_Date (date_id, full_date, [year], [month], day_of_week, day_type, season)&#xA;SELECT &#xA;    YEAR(DateValue) * 10000 + Month(DateValue) * 100 + DAY(DateValue) AS date_id,&#xA;    DateValue AS full_date,&#xA;    YEAR(DateValue) AS [year],&#xA;    MONTH(DateValue) AS [month],&#xA;    DATENAME(WEEKDAY, DateValue) AS day_of_week,&#xA;    CASE &#xA;        WHEN DATEPART(WEEKDAY, DateValue) IN (6, 7) THEN 'Weekend' &#xA;        ELSE 'Weekday' &#xA;    END AS day_type,&#xA;    CASE &#xA;        WHEN MONTH(DateValue) IN (12, 1, 2) THEN 'Winter'&#xA;        WHEN MONTH(DateValue) IN (3, 4, 5)  THEN 'Spring'&#xA;        WHEN MONTH(DateValue) IN (6, 7, 8)  THEN 'Summer'&#xA;        WHEN MONTH(DateValue) IN (9, 10, 11) THEN 'Autumn'&#xA;    END AS season&#xA;FROM DateCTE&#xA;WHERE NOT EXISTS (&#xA;    SELECT 1 &#xA;    FROM Dim_Date d &#xA;    WHERE d.date_id = (YEAR(DateValue) * 10000 + MONTH(DateValue) * 100 + DAY(DateValue))&#xA;)&#xA;OPTION (MAXRECURSION 0);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
