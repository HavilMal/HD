          SQLTask:SqlStatementSource="TRUNCATE TABLE [dbo].[Stacje Poczekalnia];  &#xA;TRUNCATE TABLE [dbo].[Stacje Czyste];&#xA;TRUNCATE TABLE [dbo].[Stacje Duplikaty];&#xA;TRUNCATE TABLE [dbo].[Pogoda Poczekalnia];&#xA;TRUNCATE TABLE [dbo].[Pogoda Czysta];&#xA;TRUNCATE TABLE [dbo].[Wypożyczenia Poczekalnia];&#xA;TRUNCATE TABLE [dbo].[Wypożyczenia Czyste];" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
