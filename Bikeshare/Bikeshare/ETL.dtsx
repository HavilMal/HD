                      expressionType="Notify"
                      name="FriendlyExpression">(ISNULL(start_lat) || (start_lat &gt;= 38.22 &amp;&amp; start_lat &lt;= 39.57)) &amp;&amp; (ISNULL(start_lng) || (start_lng &gt;= -77.90 &amp;&amp; start_lng &lt;= -76.17)) &amp;&amp; (ISNULL(end_lat) || (end_lat &gt;= 38.22 &amp;&amp; end_lat &lt;= 39.57)) &amp;&amp; (ISNULL(end_lng) || (end_lng &gt;= -77.90 &amp;&amp; end_lng &lt;= -76.17))</property>
