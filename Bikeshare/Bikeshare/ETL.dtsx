                      dataType="System.String"
                      description="Specifies the expression. This expression version uses lineage identifiers instead of column names."
                      name="Expression">([ISNULL](#{Package\Czyszczenie Wypożyczeń\Wypożyczenia Bez Duplikatów.Outputs[OLE DB Source Output].Columns[start_lat]}) || (#{Package\Czyszczenie Wypożyczeń\Wypożyczenia Bez Duplikatów.Outputs[OLE DB Source Output].Columns[start_lat]} &gt;= 38.22 &amp;&amp; #{Package\Czyszczenie Wypożyczeń\Wypożyczenia Bez Duplikatów.Outputs[OLE DB Source Output].Columns[start_lat]} &lt;= 39.57)) &amp;&amp; ([ISNULL](#{Package\Czyszczenie Wypożyczeń\Wypożyczenia Bez Duplikatów.Outputs[OLE DB Source Output].Columns[start_lng]}) || (#{Package\Czyszczenie Wypożyczeń\Wypożyczenia Bez Duplikatów.Outputs[OLE DB Source Output].Columns[start_lng]} &gt;= -77.90 &amp;&amp; #{Package\Czyszczenie Wypożyczeń\Wypożyczenia Bez Duplikatów.Outputs[OLE DB Source Output].Columns[start_lng]} &lt;= -76.17)) &amp;&amp; ([ISNULL](#{Package\Czyszczenie Wypożyczeń\Wypożyczenia Bez Duplikatów.Outputs[OLE DB Source Output].Columns[end_lat]}) || (#{Package\Czyszczenie Wypożyczeń\Wypożyczenia Bez Duplikatów.Outputs[OLE DB Source Output].Columns[end_lat]} &gt;= 38.22 &amp;&amp; #{Package\Czyszczenie Wypożyczeń\Wypożyczenia Bez Duplikatów.Outputs[OLE DB Source Output].Columns[end_lat]} &lt;= 39.57)) &amp;&amp; ([ISNULL](#{Package\Czyszczenie Wypożyczeń\Wypożyczenia Bez Duplikatów.Outputs[OLE DB Source Output].Columns[end_lng]}) || (#{Package\Czyszczenie Wypożyczeń\Wypożyczenia Bez Duplikatów.Outputs[OLE DB Source Output].Columns[end_lng]} &gt;= -77.90 &amp;&amp; #{Package\Czyszczenie Wypożyczeń\Wypożyczenia Bez Duplikatów.Outputs[OLE DB Source Output].Columns[end_lng]} &lt;= -76.17))</property>
