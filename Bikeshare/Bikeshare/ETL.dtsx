                  expressionType="Notify"
                  name="SqlCommandParam"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">select * from (select * from [dbo].[Stacje Poczekalnia]) [refTable]
where [refTable].[station_name] = ?</property>
