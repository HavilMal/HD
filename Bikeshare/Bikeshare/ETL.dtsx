                  truncationRowDisposition="FailComponent">
                  <properties>
                    <property
                      containsID="true"
                      dataType="System.String"
                      description="Specifies the expression. This expression version uses lineage identifiers instead of column names."
                      name="Expression">(![ISNULL](#{Package\Czyszczenie Wypożyczeń\Wypożyczenia Bez Duplikatów.Outputs[OLE DB Source Output].Columns[started_at]}) &amp;&amp; ![ISNULL](#{Package\Czyszczenie Wypożyczeń\Wypożyczenia Bez Duplikatów.Outputs[OLE DB Source Output].Columns[ended_at]})) &amp;&amp; (#{Package\Czyszczenie Wypożyczeń\Wypożyczenia Bez Duplikatów.Outputs[OLE DB Source Output].Columns[ended_at]} &gt; #{Package\Czyszczenie Wypożyczeń\Wypożyczenia Bez Duplikatów.Outputs[OLE DB Source Output].Columns[started_at]}) &amp;&amp; (#{Package\Czyszczenie Wypożyczeń\Wypożyczenia Bez Duplikatów.Outputs[OLE DB Source Output].Columns[started_at]} &gt;= (DT_DBTIMESTAMP)"2020-05-01 00:00:00" &amp;&amp; #{Package\Czyszczenie Wypożyczeń\Wypożyczenia Bez Duplikatów.Outputs[OLE DB Source Output].Columns[started_at]} &lt;= (DT_DBTIMESTAMP)"2024-08-31 23:59:59") &amp;&amp; (#{Package\Czyszczenie Wypożyczeń\Wypożyczenia Bez Duplikatów.Outputs[OLE DB Source Output].Columns[ended_at]} &gt;= (DT_DBTIMESTAMP)"2020-05-01 00:00:00" &amp;&amp; #{Package\Czyszczenie Wypożyczeń\Wypożyczenia Bez Duplikatów.Outputs[OLE DB Source Output].Columns[ended_at]} &lt;= (DT_DBTIMESTAMP)"2024-08-31 23:59:59")</property>
                    <property
                      containsID="true"
                      dataType="System.String"
                      description="Specifies the friendly version of the expression. This expression version uses column names."
                      expressionType="Notify"
                      name="FriendlyExpression">(!ISNULL(started_at) &amp;&amp; !ISNULL(ended_at)) &amp;&amp; (ended_at &gt; started_at) &amp;&amp; (started_at &gt;= (DT_DBTIMESTAMP)"2020-05-01 00:00:00" &amp;&amp; started_at &lt;= (DT_DBTIMESTAMP)"2024-08-31 23:59:59") &amp;&amp; (ended_at &gt;= (DT_DBTIMESTAMP)"2020-05-01 00:00:00" &amp;&amp; ended_at &lt;= (DT_DBTIMESTAMP)"2024-08-31 23:59:59")</property>
                    <property
                      dataType="System.Int32"
