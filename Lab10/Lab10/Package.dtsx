    <DTS:Executable
      DTS:refId="Package\Generowanie Dat"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{C896F8A9-91F3-4401-ABDD-4901C79E9615}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Generowanie Dat"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{F74B0A79-FD8F-48EE-A83D-0F04F6525599}"
          SQLTask:SqlStatementSource="DECLARE @StartDate DATE = '2020-01-01';&#xA;DECLARE @EndDate   DATE = '2030-12-31';&#xA;&#xA;WITH DateAnchor AS (&#xA;    SELECT @StartDate AS CurrentDate&#xA;    UNION ALL&#xA;    SELECT DATEADD(DAY, 1, CurrentDate)&#xA;    FROM DateAnchor&#xA;    WHERE CurrentDate &lt; @EndDate&#xA;),&#xA;CalculatedDates AS (&#xA;    SELECT &#xA;        (10000 * YEAR(CurrentDate)) + (100 * MONTH(CurrentDate)) + DAY(CurrentDate) AS DateKey,&#xA;        CurrentDate AS FullDateAlternateKey,&#xA;        CAST(DATEPART(WEEKDAY, CurrentDate) AS TINYINT) AS DayNumberOfWeek,&#xA;        CAST(DATENAME(WEEKDAY, CurrentDate) AS NVARCHAR(10)) AS EnglishDayNameOfWeek,&#xA;        CAST(DATEPART(DAY, CurrentDate) AS TINYINT) AS DayNumberOfMonth,&#xA;        CAST(DATEPART(DAYOFYEAR, CurrentDate) AS SMALLINT) AS DayNumberOfYear,&#xA;        CAST(DATEPART(WEEK, CurrentDate) AS TINYINT) AS WeekNumberOfYear,&#xA;        CAST(DATENAME(MONTH, CurrentDate) AS NVARCHAR(10)) AS EnglishMonthName,&#xA;        CAST(DATEPART(MONTH, CurrentDate) AS TINYINT) AS MonthNumberOfYear,&#xA;        CAST(DATEPART(QUARTER, CurrentDate) AS TINYINT) AS CalendarQuarter,&#xA;        CAST(DATEPART(YEAR, CurrentDate) AS SMALLINT) AS CalendarYear,&#xA;        CAST(CASE WHEN DATEPART(MONTH, CurrentDate) &lt;= 6 THEN 1 ELSE 2 END AS TINYINT) AS CalendarSemester&#xA;    FROM DateAnchor&#xA;)&#xA;INSERT INTO [dbo].[DimDate] (&#xA;    [DateKey], [FullDateAlternateKey], [DayNumberOfWeek], [EnglishDayNameOfWeek],&#xA;    [DayNumberOfMonth], [DayNumberOfYear], [WeekNumberOfYear], [EnglishMonthName],&#xA;    [MonthNumberOfYear], [CalendarQuarter], [CalendarYear], [CalendarSemester]&#xA;)&#xA;SELECT src.*&#xA;FROM CalculatedDates src&#xA;WHERE NOT EXISTS (&#xA;    SELECT 1 &#xA;    FROM [dbo].[DimDate] tgt &#xA;    WHERE tgt.DateKey = src.DateKey&#xA;)&#xA;OPTION (MAXRECURSION 0);&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Opróżnianie Poczekalni"
