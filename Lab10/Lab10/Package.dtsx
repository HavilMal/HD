          SQLTask:SqlStatementSource="TRUNCATE TABLE [dbo].[StgCustomer];&#xA;TRUNCATE TABLE [dbo].[StgFactSales];&#xA;TRUNCATE TABLE [dbo].[StgProduct];" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
