    <DTS:Executable
      DTS:refId="Package\Przedziały Wiekowe"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{70B2860A-48D6-42DC-9ABB-A9BB1F069074}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Przedziały Wiekowe"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{F74B0A79-FD8F-48EE-A83D-0F04F6525599}"
          SQLTask:SqlStatementSource="INSERT INTO [dbo].[DimAgeGroup] ([AgeGroupID], [AgeGroup], [MinYear], [MaxYear])&#xA;SELECT * FROM (VALUES&#xA;    (1, '0-17',  0,  17),&#xA;    (2, '18-25', 18, 25),&#xA;    (3, '26-35', 26, 35),&#xA;    (4, '36-45', 36, 45),&#xA;    (5, '46-55', 46, 55),&#xA;    (6, '56-65', 56, 65),&#xA;    (7, '65+',   66, 150)&#xA;) AS SourceData([AgeGroupID], [AgeGroup], [MinYear], [MaxYear])&#xA;WHERE NOT EXISTS (&#xA;    SELECT 1 &#xA;    FROM [dbo].[DimAgeGroup] [target] &#xA;    WHERE [target].[AgeGroupID] = SourceData.[AgeGroupID]&#xA;);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Wczytanie Danych Produktów"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{5FB13057-C5C3-4069-9CCB-9CED5DE3E2E5}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Wczytanie Danych Produktów"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{39924C3E-FDB7-480A-AAFA-5BD16AFD49A6}"
          SQLTask:SqlStatementSource="MERGE [Lab10ETLStaging].[dbo].[StgProduct] AS Trg&#xA;USING&#xA;(&#xA;    SELECT &#xA;        p.[ProductID], &#xA;        p.[Name],&#xA;        p.[Color], &#xA;        p.[ListPrice], &#xA;        p.[Size], &#xA;        p.[Weight],&#xA;        p.[ProductLine], &#xA;        p.[Class], &#xA;        p.[Style],&#xA;        p.[ProductSubcategoryID], &#xA;        ISNULL(ps.[Name], 'Brak') AS [ProductSubcategoryName],&#xA;        pc.[ProductCategoryID],&#xA;        ISNULL(pc.[Name], 'Brak') AS [ProductCategoryName],&#xA;        p.[ProductModelID], &#xA;        ISNULL(pm.[Name], 'Brak') AS [ModelName],&#xA;        p.[SizeUnitMeasureCode]&#xA;    FROM [OLTP].production.[Product] p&#xA;    LEFT JOIN [OLTP].production.[ProductSubcategory] ps &#xA;        ON p.ProductSubcategoryID = ps.ProductSubcategoryID&#xA;    LEFT JOIN [OLTP].production.[ProductCategory] pc &#xA;        ON ps.ProductCategoryID = pc.ProductCategoryID&#xA;    LEFT JOIN [OLTP].production.[ProductModel] pm&#xA;        ON p.ProductModelID = pm.ProductModelID&#xA;) Src&#xA;ON Trg.ProductID = Src.ProductID&#xA;WHEN NOT MATCHED THEN&#xA;    INSERT (&#xA;        [ProductID], &#xA;        [Name], &#xA;        [Color], &#xA;        [ListPrice], &#xA;        [Size], &#xA;        [Weight], &#xA;        [ProductLine], &#xA;        [Class], &#xA;        [Style],&#xA;        [ProductSubcategoryID], &#xA;        [ProductSubcategoryName], &#xA;        [ProductCategoryID],      &#xA;        [ProductCategoryName],    &#xA;        [ProductModelID], &#xA;        [ModelName],              &#xA;        [SizeUnitMeasureCode]&#xA;    )&#xA;    VALUES (&#xA;        Src.[ProductID], &#xA;        Src.[Name], &#xA;        Src.[Color], &#xA;        Src.[ListPrice], &#xA;        Src.[Size], &#xA;        Src.[Weight], &#xA;        Src.[ProductLine], &#xA;        Src.[Class], &#xA;        Src.[Style],&#xA;        Src.[ProductSubcategoryID], &#xA;        Src.[ProductSubcategoryName],&#xA;        Src.[ProductCategoryID],&#xA;        Src.[ProductCategoryName],&#xA;        Src.[ProductModelID], &#xA;        Src.[ModelName],&#xA;        Src.[SizeUnitMeasureCode]&#xA;    );" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Wczytanie Danych Sprzedaży"
      DTS:CreationName="Microsoft.Pipeline"
      DTS:Description="Data Flow Task"
      DTS:DTSID="{6EFF73F5-FB94-4AFA-BC6F-97791982ADCE}"
      DTS:ExecutableType="Microsoft.Pipeline"
      DTS:LocaleID="-1"
      DTS:ObjectName="Wczytanie Danych Sprzedaży"
      DTS:TaskContact="Performs high-performance data extraction, transformation and loading;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1">
      <DTS:Variables />
      <DTS:ObjectData>
        <pipeline
          version="1">
          <components>
            <component
              refId="Package\Wczytanie Danych Sprzedaży\Dane Sprzedaży"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
              description="OLE DB Source"
              name="Dane Sprzedaży"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT 
    soh.[SalesOrderID], 
    soh.[SalesOrderNumber],
    sod.[SalesOrderDetailID] AS SalesOrderLineNumber,
    CAST(soh.OrderDate AS DATE) AS OrderDate,
    10000 * YEAR(soh.OrderDate) + 100 * MONTH(soh.OrderDate) + DAY(soh.OrderDate) AS OrderDateKey,
    CAST(soh.DueDate AS DATE) AS DueDate,
    10000 * YEAR(soh.DueDate) + 100 * MONTH(soh.DueDate) + DAY(soh.DueDate) AS DueDateKey,
    sod.ProductID,
    sc.[BusinessEntityID] AS CustomerID,
    sod.OrderQty,
    (sod.UnitPrice * sod.OrderQty) AS SalesAmount,
    CASE
        WHEN calc.AgeAtSale &lt; 18 THEN '0-17'
        WHEN calc.AgeAtSale BETWEEN 18 AND 25 THEN '18-25'
        WHEN calc.AgeAtSale BETWEEN 26 AND 35 THEN '26-35'
        WHEN calc.AgeAtSale BETWEEN 36 AND 45 THEN '36-45'
        WHEN calc.AgeAtSale BETWEEN 46 AND 55 THEN '46-55'
        WHEN calc.AgeAtSale BETWEEN 56 AND 65 THEN '56-65'
        ELSE '65+'
    END AS AgeGroup,
    CASE
        WHEN calc.AgeAtSale &lt; 18 THEN 1
        WHEN calc.AgeAtSale BETWEEN 18 AND 25 THEN 2
        WHEN calc.AgeAtSale BETWEEN 26 AND 35 THEN 3
        WHEN calc.AgeAtSale BETWEEN 36 AND 45 THEN 4
        WHEN calc.AgeAtSale BETWEEN 46 AND 55 THEN 5
        WHEN calc.AgeAtSale BETWEEN 56 AND 65 THEN 6
        ELSE 7
    END AS AgeGroupID,
    AgeAtSale
FROM 
    [Sales].[SalesOrderHeader] soh 
JOIN 
    [Sales].[SalesOrderDetail] sod ON soh.SalesOrderID = sod.SalesOrderID
JOIN 
    [Sales].[Customer] c ON soh.CustomerID = c.CustomerID
JOIN 
    [Lab10ETLStaging].[dbo].[StgCustomer] sc ON c.PersonID = sc.BusinessEntityID
CROSS APPLY (
    SELECT 
        DATEDIFF(YEAR, sc.BirthDate, soh.OrderDate) - 
        CASE 
            WHEN DATEADD(YEAR, DATEDIFF(YEAR, sc.BirthDate, soh.OrderDate), sc.BirthDate) &gt; soh.OrderDate THEN 1 
            ELSE 0 
        END AS AgeAtSale
) calc;</property>
                <property
                  dataType="System.String"
                  description="The variable that contains the SQL command to be executed."
                  name="SqlCommandVariable"></property>
                <property
                  dataType="System.Int32"
                  description="Specifies the column code page to use when code page information is unavailable from the data source."
                  name="DefaultCodePage">1250</property>
                <property
                  dataType="System.Boolean"
                  description="Forces the use of the DefaultCodePage property value when describing character data."
                  name="AlwaysUseDefaultCodePage">false</property>
                <property
                  dataType="System.Int32"
                  description="Specifies the mode used to access the database."
                  name="AccessMode"
                  typeConverter="AccessMode">2</property>
                <property
                  dataType="System.String"
                  description="The mappings between the parameters in the SQL command and variables."
                  name="ParameterMapping"></property>
              </properties>
              <connections>
                <connection
                  refId="Package\Wczytanie Danych Sprzedaży\Dane Sprzedaży.Connections[OleDbConnection]"
                  connectionManagerID="Package.ConnectionManagers[localhost.OLTP]"
                  connectionManagerRefId="Package.ConnectionManagers[localhost.OLTP]"
                  description="The OLE DB runtime connection used to access the database."
                  name="OleDbConnection" />
              </connections>
              <outputs>
                <output
                  refId="Package\Wczytanie Danych Sprzedaży\Dane Sprzedaży.Outputs[OLE DB Source Output]"
                  name="OLE DB Source Output">
                  <outputColumns>
                    <outputColumn
                      refId="Package\Wczytanie Danych Sprzedaży\Dane Sprzedaży.Outputs[OLE DB Source Output].Columns[SalesOrderID]"
                      dataType="i4"
                      errorOrTruncationOperation="Conversion"
                      errorRowDisposition="FailComponent"
                      externalMetadataColumnId="Package\Wczytanie Danych Sprzedaży\Dane Sprzedaży.Outputs[OLE DB Source Output].ExternalColumns[SalesOrderID]"
                      lineageId="Package\Wczytanie Danych Sprzedaży\Dane Sprzedaży.Outputs[OLE DB Source Output].Columns[SalesOrderID]"
                      name="SalesOrderID"
                      truncationRowDisposition="FailComponent" />
                    <outputColumn
                      refId="Package\Wczytanie Danych Sprzedaży\Dane Sprzedaży.Outputs[OLE DB Source Output].Columns[SalesOrderNumber]"
                      dataType="wstr"
                      errorOrTruncationOperation="Conversion"
                      errorRowDisposition="FailComponent"
                      externalMetadataColumnId="Package\Wczytanie Danych Sprzedaży\Dane Sprzedaży.Outputs[OLE DB Source Output].ExternalColumns[SalesOrderNumber]"
                      length="25"
                      lineageId="Package\Wczytanie Danych Sprzedaży\Dane Sprzedaży.Outputs[OLE DB Source Output].Columns[SalesOrderNumber]"
                      name="SalesOrderNumber"
                      truncationRowDisposition="FailComponent" />
                    <outputColumn
                      refId="Package\Wczytanie Danych Sprzedaży\Dane Sprzedaży.Outputs[OLE DB Source Output].Columns[SalesOrderLineNumber]"
                      dataType="i4"
                      errorOrTruncationOperation="Conversion"
                      errorRowDisposition="FailComponent"
                      externalMetadataColumnId="Package\Wczytanie Danych Sprzedaży\Dane Sprzedaży.Outputs[OLE DB Source Output].ExternalColumns[SalesOrderLineNumber]"
                      lineageId="Package\Wczytanie Danych Sprzedaży\Dane Sprzedaży.Outputs[OLE DB Source Output].Columns[SalesOrderLineNumber]"
                      name="SalesOrderLineNumber"
                      truncationRowDisposition="FailComponent" />
                    <outputColumn
                      refId="Package\Wczytanie Danych Sprzedaży\Dane Sprzedaży.Outputs[OLE DB Source Output].Columns[OrderDate]"
                      dataType="wstr"
                      errorOrTruncationOperation="Conversion"
                      errorRowDisposition="FailComponent"
                      externalMetadataColumnId="Package\Wczytanie Danych Sprzedaży\Dane Sprzedaży.Outputs[OLE DB Source Output].ExternalColumns[OrderDate]"
                      length="10"
