  <Source dwd:design-time-name="dc91542f-bf07-4fa9-99c2-526db2a90727">
    <DataSourceViewID>DW</DataSourceViewID>
  </Source>
  <MdxScripts>
    <MdxScript dwd:design-time-name="f6919ecf-cca4-4718-9b04-6f8c4e1e0066">
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>0001-01-01T00:00:00Z</CreatedTimestamp>
      <LastSchemaUpdate>0001-01-01T00:00:00Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>/*
The CALCULATE command controls the aggregation of leaf cells in the cube.
If the CALCULATE command is deleted or modified, the data within the cube is affected.
You should edit this command only if you manually specify how the cube is aggregated.
*/
CALCULATE; 
CREATE MEMBER CURRENTCUBE.[Measures].[Sumaryczna Sprzedaż]
 AS [Measures].[Sales Amount - Internet] + [Measures].[Sales Amount - Reseller], 
FORMAT_STRING = "Currency", 
VISIBLE = 1  ; 

-----

CREATE MEMBER CURRENTCUBE.[Measures].[Liczba zamówień]
AS
[Measures].[Internet Sales Amount]
+ [Measures].[Reseller Sales Amount],
FORMAT_STRING = "Standard";

----

CREATE MEMBER CURRENTCUBE.[Measures].[Zysk brutto]
AS
[Measures].[Sales Amount] - [Measures].[Total Product Cost],
FORMAT_STRING = "Currency";

----

CREATE MEMBER CURRENTCUBE.[Measures].[Marża %]
AS
IIF(
[Measures].[Sales Amount - Internet] = 0,
NULL,
([Measures].[Sales Amount - Internet] - [Measures].[Total Product Cost - Internet])
/ [Measures].[Sales Amount - Internet]
),
FORMAT_STRING = "Percent";</Text>
        </Command>
      </Commands>
    </MdxScript>
  </MdxScripts>
  <Kpis>
    <Kpi dwd:design-time-name="9e97b6ac-fcd7-43d0-873b-dcc682b4e217">
      <ID>KPI</ID>
      <Name>Marża</Name>
      <Value>[Measures].[Marża %]</Value>
      <Goal>0.20</Goal>
      <Status>CASE
WHEN [Measures].[Marża %] &gt;= 0.2 THEN 1
WHEN [Measures].[Marża %] &gt;= 0.15 THEN 0
ELSE -1
END</Status>
      <TrendGraphic>Standard Arrow</TrendGraphic>
      <StatusGraphic>Gauge - Ascending</StatusGraphic>
    </Kpi>
  </Kpis>
</Cube>